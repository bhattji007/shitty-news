---
import Base from '../layouts/Base.astro';
---
<Base title="Scheduled maintenance — ShittyNews.com" page="maintenance" chrome={false} overlays={false}>
  <div class="plain">
    <h1>We'll be back shortly.</h1>
    <p>ShittyNews.com is undergoing scheduled maintenance. We are upgrading our servers so that we can show you more advertisements, faster.</p>
    <p>In the meantime, please notice how calm this page is. No pop-ups. No sticky banner. A font size a human can read. It's almost as if we could have done this all along.</p>
    <p><a href="/">← Try again</a> &nbsp;·&nbsp; <a href="/?sane=1">Keep it like this</a></p>
    <p style="font-size:12px;color:#888">Error reference: MT-1-IN-50. You will not see this page twice in a row. That's a promise, and unlike our other promises, this one is enforced by a cookie.</p>
  </div>
</Base>
