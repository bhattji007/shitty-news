---
import Base from '../layouts/Base.astro';
import HomeContent from '../components/HomeContent.astro';
import { topStories } from '../lib/news/load.ts';
import { collectionLd } from '../lib/seo.ts';
const articles = topStories();
---
<Base title="ShittyNews.com — India's #1 News Website* · Breaking News, Latest News, Nothing Happened" page="home" preloadImage={articles[0]?.image} canonical="/" jsonLd={[collectionLd('Top news', '/', articles)]}>
  <HomeContent articles={articles} live />
</Base>
