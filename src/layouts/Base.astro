---
import '../styles/global.css';
import { config } from '../annoyances/config.ts';
import Masthead from '../components/Masthead.astro';
import Ticker from '../components/Ticker.astro';
import Footer from '../components/Footer.astro';
import Overlays from '../components/Overlays.astro';
import { SITE, SITE_NAME, DEFAULT_DESCRIPTION, DEFAULT_OG_IMAGE, cleanPath, organizationLd, websiteLd } from '../lib/seo.ts';

interface Props {
  title: string;
  page: string;
  description?: string;
  chrome?: boolean;   // masthead + ticker + footer
  overlays?: boolean; // cookie stack, paywall, sticky ad
  lite?: boolean;
  preloadImage?: string | null; // the above-the-fold image, if any
  canonical?: string;           // path; defaults to the current page
  image?: string | null;        // og:image; defaults to the site card
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedAt?: string;
  jsonLd?: unknown[];           // page-specific structured data; WebSite + Organization are always included
}
const {
  title,
  page,
  description = DEFAULT_DESCRIPTION,
  chrome = true,
  overlays = true,
  lite = false,
  preloadImage = null,
  canonical,
  image = null,
  type = 'website',
  noindex = false,
  publishedAt,
  jsonLd = [],
} = Astro.props;
const canonicalUrl = new URL(cleanPath(canonical ?? Astro.url.pathname), SITE).toString();
const ogImage = image ?? DEFAULT_OG_IMAGE;
const ld = [websiteLd(), organizationLd(), ...jsonLd];
// Google Search Console HTML-tag verification: set repo variable GOOGLE_SITE_VERIFICATION, redeploy.
const gsv = (import.meta.env.GOOGLE_SITE_VERIFICATION ?? process.env.GOOGLE_SITE_VERIFICATION ?? '').trim();
const preconnect = preloadImage ? new URL(preloadImage).origin : null;

const stream = (import.meta.env.STREAM_ENABLED ?? process.env.STREAM_ENABLED) === 'true';

// Runs before first paint: ?sane=1 / ?sane=0, the sane attribute, and the 1-in-50 maintenance redirect.
const headScript = `(function(){var d=document.documentElement,q=new URLSearchParams(location.search),s=q.get('sane');
function set(n,v,a){document.cookie=n+'='+v+';path=/;SameSite=Lax;max-age='+a}
if(s==='1'){set('sane','1',2592000);['v','ov','pw','mt'].forEach(function(n){set(n,'',0)});try{sessionStorage.removeItem('sn.visit')}catch(e){}}
else if(s==='0'){set('sane','',0)}
if(/(^|; )sane=1(;|$)/.test(document.cookie)){d.setAttribute('data-sane','');return}
if(${config.maintenance ? 'true' : 'false'}&&location.pathname!=='/maintenance'&&!navigator.webdriver&&!/bot|crawl|spider|slurp|lighthouse|headless|preview|facebookexternalhit|whatsapp|telegram/i.test(navigator.userAgent)){
  if(/(^|; )mt=1(;|$)/.test(document.cookie)){set('mt','',0)}
  else if(Math.random()<0.02){set('mt','1',3600);location.replace('/maintenance')}
}})();`;
---
<!doctype html>
<html lang="en" data-page={page} data-stream={stream ? '1' : '0'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {gsv && <meta name="google-site-verification" content={gsv} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content="en_IN" />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title="ShittyNews headlines" href="/feed.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#c8102e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline set:html={headScript}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)}></script>
    {preconnect && <link rel="preconnect" href={preconnect} crossorigin="anonymous" />}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" referrerpolicy="no-referrer" />}
    {lite && <link rel="preload" as="image" href="/lite-hero.bmp" />}
  </head>
  <body>
    {lite && (
      <div class="lite-hero">
        <img src="/lite-hero.bmp" alt="" width="840" height="832" onload="document.documentElement.classList.add('lite-ready')" onerror="document.documentElement.classList.add('lite-ready')" />
      </div>
    )}
    {chrome && <Masthead lite={lite} />}
    {chrome && <Ticker />}
    <slot />
    {chrome && <Footer />}
    {overlays && <Overlays />}
    <script src="../annoyances/index.ts"></script>
  </body>
</html>
