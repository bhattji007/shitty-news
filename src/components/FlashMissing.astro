---
interface Props { path: string }
const { path } = Astro.props;
---
<div class="flash">
  <div class="win">
    <div class="titlebar">ShittyNews E-Paper — Windows Internet Explorer</div>
    <div class="inner">
      <div class="puzzle">🧩</div>
      <p><b>Adobe Flash Player is required to view the E-Paper.</b></p>
      <p>Click here to download plugin. Best viewed in Internet Explorer 6 at 800×600 resolution.</p>
      <p><a href="https://www.adobe.com/products/flashplayer/end-of-life.html" rel="nofollow noopener">Get ADOBE® FLASH® PLAYER</a></p>
      <p><button type="button" onclick="alert('Plugin download failed. Please try again in 2009.')">Install Now</button> <button type="button" onclick="history.back()">Cancel</button></p>
      <p style="font-size:11px;color:#666">HTTP 404 — The page you requested ({path}) could not be found. The E-Paper was last published on 12 August 2009. It is still loading.</p>
      <p><a href="/">Return to homepage</a></p>
    </div>
    <div class="status">Done, but with errors on page.</div>
  </div>
</div>
