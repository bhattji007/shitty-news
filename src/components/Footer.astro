---
const links = ['About Us','Advertise with Us','Careers','Terms of Use','Privacy Policy','Cookie Policy','Grievance Redressal','Sitemap','RSS','Newsletter','E-Paper','Archives','Contact Us','Property Tax','Repo Rate','IMD','Sensex Today','Gold Rate Today','Petrol Price Today','Rashifal','Horoscope Today','Cricket Score','Weather Today','Delhi News','Mumbai News','Bengaluru News','Lucknow News','Meerut News','Bareilly News','Web Stories'];
const hrefFor = (l: string) => l === 'E-Paper' ? '/e-paper' : l === 'Cookie Policy' || l === 'Privacy Policy' ? '/preferences' : l === 'Newsletter' ? '/subscribe' : '/';
---
<footer class="footer">
  <div class="in">
    <div class="wm">ShittyNews</div>
    <div class="links">{links.map((l) => <a href={hrefFor(l)}>{l}</a>)}</div>
    <div class="copy">Copyright © {new Date().getFullYear()} Shitty Media &amp; Entertainment Pvt. Ltd. All rights reserved. Reproduction in any form, including WhatsApp forwards, is prohibited. shittynews.com is not responsible for the content of shittynews.com.</div>
    <div class="powered">Headlines are shown exactly as published by their sources. No tracking, no analytics, no data collection. Powered by <a href="https://newsdata.io" rel="noopener">NewsData.io</a>. Prefer it readable? <a href="/?sane=1">?sane=1</a></div>
    <div class="sane-footer">This is what the site could have been. <a href="/?sane=0" style="color:#bbb;font-size:11px">(turn the chaos back on)</a></div>
  </div>
</footer>
