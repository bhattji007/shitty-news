---
interface Props { url: string; title: string }
const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const links: [string, string, string][] = [
  ['WhatsApp', '#25d366', `https://wa.me/?text=${t}%20${u}`],
  ['Facebook', '#3b5998', `https://www.facebook.com/sharer/sharer.php?u=${u}`],
  ['X', '#000', `https://twitter.com/intent/tweet?url=${u}&text=${t}`],
  ['Telegram', '#229ed9', `https://t.me/share/url?url=${u}&text=${t}`],
  ['LinkedIn', '#0a66c2', `https://www.linkedin.com/sharing/share-offsite/?url=${u}`],
  ['Koo', '#d9a400', 'https://www.kooapp.com/'],
  ['ShareChat', '#e94f37', 'https://sharechat.com/'],
  ['Orkut', '#d4147f', 'https://www.orkut.com/'],
  ['Google+', '#dd4b39', `https://plus.google.com/share?url=${u}`],
  ['Hike', '#0f6ef0', 'https://hike.in/'],
  ['Fax', '#8a8a8a', 'tel:+911125000000'],
  ['Email', '#666', `mailto:?subject=${t}&body=${u}`],
];
---
<div class="share" data-share data-annoy="share">
  <small>Share (14)</small>
  {links.map(([l, bg, href]) => <a href={href} style={`background:${bg}`} rel="nofollow noopener" target={href.startsWith('tel:') || href.startsWith('mailto:') ? undefined : '_blank'}>{l}</a>)}
  <button type="button" style="background:#444" data-share-print>Print</button>
  <button type="button" style="background:#2b2b2b" data-share-copy>Copy link</button>
</div>
