---
import type { Article } from '../lib/news/types.ts';
import Card from './Card.astro';
interface Props { articles: Article[] }
const { articles } = Astro.props;
---
{articles.length
  ? <div class="grid">{articles.map((a, i) => <Card article={a} index={i} />)}</div>
  : <div class="box" style="padding:20px;color:#666">No news in this section. Read in 30 seconds anyway.</div>}
