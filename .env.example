# Step 3 of the README. Yes, this file. Copy it to .env.
# I would do it for you but I have been explicitly denied filesystem write access
# to anything that matters. Which is, on reflection, probably correct.

# --- Database ------------------------------------------------------------
# SQLite for v1. The schema is portable to Postgres; change the provider in
# prisma/schema.prisma and this string, and nothing of value will be lost.
DATABASE_URL="file:./dev.db"

# --- Auth ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth. Optional. The button hides itself if you leave these empty,
# which is more dignity than most of us get.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Magic-link email. Optional. If SMTP_HOST is empty, the sign-in link is
# printed to the server console instead of mailed, so you can log in locally
# without pretending to run a mail server.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="anchor@shittynews.com"

# --- Content pipeline (scripts/generate.ts) ------------------------------
# Without this the site still works. It just stops aging.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
ANTHROPIC_JUDGE_MODEL="claude-haiku-4-5-20251001"

# Comma-separated RSS feeds. Defaults are Google News India / world / business / tech.
RSS_FEEDS=""

# How many headlines to consider per run.
GENERATE_LIMIT="24"

# Public site URL, used by /feed.xml to build absolute links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
